<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- lets the Windows app compile on Linux too (CI and checks); it only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ContrastInk.ico</ApplicationIcon>
    <AssemblyName>ContrastInk</AssemblyName>
    <RootNamespace>ContrastInk</RootNamespace>
    <Product>Contrast Ink</Product>
    <Version>0.4.0</Version>
    <Company>Contrast</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\ContrastInk.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ContrastInk.Core/ContrastInk.Core.csproj" />
  </ItemGroup>
</Project>
