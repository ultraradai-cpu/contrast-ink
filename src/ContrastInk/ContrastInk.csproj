<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows SDK's projections, for Windows.Graphics.Capture (the tablet's picture); 26100 for IsBorderRequired and MinUpdateInterval
         (Windows 11). It still runs on Windows 10: everything newer than 1809 is checked for before it is used. -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <!-- lets the Windows app compile on Linux too (CI and checks); it only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ContrastInk.ico</ApplicationIcon>
    <AssemblyName>ContrastInk</AssemblyName>
    <RootNamespace>ContrastInk</RootNamespace>
    <Product>Contrast Ink</Product>
    <Version>0.4.0</Version>
    <Company>Contrast</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\ContrastInk.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ContrastInk.Core/ContrastInk.Core.csproj" />
  </ItemGroup>
</Project>
