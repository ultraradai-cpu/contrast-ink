<Window x:Class="ContrastInk.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrast Ink"
        WindowStyle="None" AllowsTransparency="False" Background="#141A22"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Inter, Segoe UI" FontSize="13" Icon="Assets/ContrastInk.ico">
  <Window.Resources>
    <!-- Contrast colours (from the Contrast app): dark ink bar, logo blue for what is switched on -->
    <SolidColorBrush x:Key="Bar" Color="#141A22"/>
    <SolidColorBrush x:Key="Ink" Color="#E3E8F0"/>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <Style x:Key="Tb" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <!-- 32 wide: the whole toolbar (with the laser and the opacity slider) must fit a 1024-wide screen -->
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33E3E8F0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Margin" Value="5,8"/><Setter Property="Background" Value="#408A95A6"/>
    </Style>
  </Window.Resources>

  <!-- a solid window (not see-through): the plainest case for hiding from capture (Microsoft's page says nothing about
       see-through windows either way); Windows 11 rounds its corners -->
  <Border x:Name="Frame" Background="{StaticResource Bar}" Padding="4" BorderBrush="#552563EB" BorderThickness="1">
    <StackPanel>
    <StackPanel Orientation="Horizontal">
      <!-- drag handle -->
      <!-- the Contrast mark is the drag handle; the dots beside it turn red if the toolbar can't be hidden from OBS -->
      <Border x:Name="Grip" Cursor="SizeAll" Background="Transparent" Padding="4,0,2,0" ToolTip="Contrast Ink. Drag to move. The toolbar is hidden from OBS recordings.">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/mark.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="GripText" Text="⋮" Foreground="{StaticResource Blue}" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14"/>
        </StackPanel>
      </Border>
      <Button x:Name="DrawBtn" Style="{StaticResource Tb}" Width="58" ToolTip="Draw on / off (F9). Or hold Ctrl to draw. A pen draws by itself.">
        <StackPanel Orientation="Horizontal"><TextBlock Text="✏"/><TextBlock x:Name="DrawText" Text=" Off" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <!-- recording with OBS: stays visible when the toolbar is made small. ⏸ and the timer keep their room when
           hidden, so pressing ⏺ never changes the toolbar's width: on a narrow screen that slid the whole toolbar,
           and ⏹ away from the pointer (seen in the Windows check) -->
      <Border Style="{StaticResource Sep}"/>
      <Button x:Name="RecBtn" Style="{StaticResource Tb}" ToolTip="Record with OBS (start / stop)">
        <TextBlock x:Name="RecDot" Text="⏺" Foreground="#8A95A6"/>
      </Button>
      <Button x:Name="PauseBtn" Style="{StaticResource Tb}" Content="⏸" Visibility="Hidden" ToolTip="Pause recording"/>
      <TextBlock x:Name="RecTime" Visibility="Hidden" Width="52" Foreground="{StaticResource Ink}" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0" FontFamily="Consolas, Segoe UI"/>
      <!-- the tools: one row, or two when the screen is too narrow for one (the app sets MaxWidth to what fits) -->
      <WrapPanel x:Name="Full" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="PenBtn" Style="{StaticResource Tb}" Content="🖊" ToolTip="Pen (P)"/>
        <Button x:Name="HighBtn" Style="{StaticResource Tb}" Content="🖍" ToolTip="Highlighter (H)"/>
        <Button x:Name="ArrowBtn" Style="{StaticResource Tb}" Content="➚" ToolTip="Arrow (A): drag from the tail to the tip"/>
        <Button x:Name="OvalBtn" Style="{StaticResource Tb}" Content="◯" ToolTip="Circle a finding (O). Hold Shift for a perfect circle."/>
        <Button x:Name="EraseBtn" Style="{StaticResource Tb}" Content="⌫" ToolTip="Eraser (E): touch a mark to remove it"/>
        <Button x:Name="LaserBtn" Style="{StaticResource Tb}" ToolTip="Laser pointer (L): a red dot follows the pen or mouse; touching draws a glowing line that fades in a second. Never a mark.">
          <TextBlock Text="●" Foreground="#FF2D2D" FontSize="15"/>
        </Button>
        <Border Style="{StaticResource Sep}"/>
        <StackPanel x:Name="ColorPanel" Orientation="Horizontal"/>
        <Border Style="{StaticResource Sep}"/>
        <StackPanel x:Name="WidthPanel" Orientation="Horizontal"/>
        <!-- opacity of new pen, arrow and circle marks: 10% to 100% (narrow: the whole toolbar must fit a 1024-wide screen;
             the value is in its name, shown under the buttons while the mouse or pen rests on it) -->
        <Slider x:Name="OpacitySlider" Width="56" Minimum="0.1" Maximum="1" SmallChange="0.1" LargeChange="0.1"
                VerticalAlignment="Center" Margin="2,0" Focusable="False" IsMoveToPointEnabled="True"
                ToolTip="Opacity 100%: of the pen, arrow and circle (new marks). The highlighter keeps its own see-through look."/>
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="FadeBtn" Style="{StaticResource Tb}" Content="⏳" ToolTip="Fading ink (F): marks disappear after 3 seconds. Hold Shift while drawing to keep one."/>
        <Button x:Name="UndoBtn" Style="{StaticResource Tb}" Content="↶" ToolTip="Undo (Ctrl+Z)"/>
        <Button x:Name="ClearBtn" Style="{StaticResource Tb}" Content="🗑" ToolTip="Clear all marks (C). Undo brings them back."/>
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="ScreenBtn" Style="{StaticResource Tb}" Width="46" ToolTip="Move the drawing layer to the other screen">
          <StackPanel Orientation="Horizontal"><TextBlock Text="🖥"/><TextBlock x:Name="ScreenText" Text="1" FontSize="12" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="SettingsBtn" Style="{StaticResource Tb}" Content="⚙" ToolTip="Settings: ways to undo, and marks for each slide"/>
      </WrapPanel>
      <Button x:Name="FoldBtn" Style="{StaticResource Tb}" Width="26" Content="‹" ToolTip="Make the toolbar small / big"/>
      <Button x:Name="CloseBtn" Style="{StaticResource Tb}" Width="28" Content="✕" FontSize="13" ToolTip="Quit Contrast Ink"/>
    </StackPanel>
    <!-- settings open inside the toolbar, so they are hidden from recordings like the rest of it -->
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="10,6,10,8">
      <StackPanel.Resources>
        <Style TargetType="CheckBox">
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="Margin" Value="0,3"/>
          <Setter Property="Cursor" Value="Hand"/>
        </Style>
      </StackPanel.Resources>
      <TextBlock Text="Undo the Last Mark With" Foreground="#8A95A6" FontSize="12" Margin="0,0,0,2"/>
      <CheckBox x:Name="OptZ" Content="Z Key (Ctrl+Z Always Works)"/>
      <CheckBox x:Name="OptRightClick" Content="Right-Click or the Pen's Side Button"/>
      <CheckBox x:Name="OptButton" Content="Undo Button Beside the Last Mark (Hidden From OBS)"/>
      <TextBlock Text="Pen and Slides" Foreground="#8A95A6" FontSize="12" Margin="0,8,0,2"/>
      <CheckBox x:Name="OptEraserEnd" Content="Pen's Eraser End Erases"/>
      <CheckBox x:Name="OptSlides" Content="Each PowerPoint Slide Keeps Its Own Marks"/>
      <CheckBox x:Name="OptTablet" Content="Pen Tablet Beside the Keyboard (XP-Pen, Wacom Intuos, Huion): Its Pen Works Like a Mouse"/>
      <TextBlock Text="Toolbar" Foreground="#8A95A6" FontSize="12" Margin="0,8,0,2"/>
      <CheckBox x:Name="OptNames" Content="Show Button Names When the Mouse or Pen Rests on One"/>
    </StackPanel>
    <!-- hover help is shown here, inside the toolbar, so OBS never records it (real tooltips are separate windows) -->
    <TextBlock x:Name="Hint" Cursor="Hand" Visibility="Collapsed" Foreground="{StaticResource Ink}" FontSize="12" Margin="8,2,8,4" TextWrapping="Wrap" MaxWidth="640"/>
    </StackPanel>
  </Border>
</Window>
