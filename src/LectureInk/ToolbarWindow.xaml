<Window x:Class="LectureInk.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecture Ink"
        WindowStyle="None" AllowsTransparency="False" Background="#2B1512"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <!-- Gavan colours: deep maroon bar, gold for what is switched on -->
    <SolidColorBrush x:Key="Bar" Color="#F22B1512"/>
    <SolidColorBrush x:Key="Ink" Color="#F6EBDD"/>
    <SolidColorBrush x:Key="Gold" Color="#D8B76E"/>
    <Style x:Key="Tb" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33F6EBDD"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Margin" Value="5,8"/><Setter Property="Background" Value="#40F6EBDD"/>
    </Style>
  </Window.Resources>

  <!-- a solid window (not see-through): Windows reliably keeps it out of OBS; Windows 11 rounds its corners -->
  <Border x:Name="Frame" Background="{StaticResource Bar}" Padding="4" BorderBrush="#55D8B76E" BorderThickness="1">
    <StackPanel>
    <StackPanel Orientation="Horizontal">
      <!-- drag handle -->
      <Border x:Name="Grip" Width="16" Cursor="SizeAll" Background="Transparent" ToolTip="Drag to move. The toolbar is hidden from OBS recordings.">
        <TextBlock x:Name="GripText" Text="⋮⋮" Foreground="{StaticResource Gold}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
      </Border>
      <Button x:Name="DrawBtn" Style="{StaticResource Tb}" Width="58" ToolTip="Draw on / off (F9). Or hold Ctrl to draw. A pen draws by itself.">
        <StackPanel Orientation="Horizontal"><TextBlock Text="✏"/><TextBlock x:Name="DrawText" Text=" Off" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <StackPanel x:Name="Full" Orientation="Horizontal">
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="PenBtn" Style="{StaticResource Tb}" Content="🖊" ToolTip="Pen (P)"/>
        <Button x:Name="HighBtn" Style="{StaticResource Tb}" Content="🖍" ToolTip="Highlighter (H)"/>
        <Button x:Name="ArrowBtn" Style="{StaticResource Tb}" Content="➚" ToolTip="Arrow (A): drag from the tail to the tip"/>
        <Button x:Name="OvalBtn" Style="{StaticResource Tb}" Content="◯" ToolTip="Circle a finding (O). Hold Shift for a perfect circle."/>
        <Button x:Name="EraseBtn" Style="{StaticResource Tb}" Content="⌫" ToolTip="Eraser (E): touch a mark to remove it"/>
        <Border Style="{StaticResource Sep}"/>
        <StackPanel x:Name="ColorPanel" Orientation="Horizontal"/>
        <Border Style="{StaticResource Sep}"/>
        <StackPanel x:Name="WidthPanel" Orientation="Horizontal"/>
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="FadeBtn" Style="{StaticResource Tb}" Content="⏳" ToolTip="Fading ink (F): marks disappear after 3 seconds. Hold Shift while drawing to keep one."/>
        <Button x:Name="UndoBtn" Style="{StaticResource Tb}" Content="↶" ToolTip="Undo (Ctrl+Z)"/>
        <Button x:Name="ClearBtn" Style="{StaticResource Tb}" Content="🗑" ToolTip="Clear all marks (C). Undo brings them back."/>
        <Border Style="{StaticResource Sep}"/>
        <Button x:Name="ScreenBtn" Style="{StaticResource Tb}" Width="46" ToolTip="Move the drawing layer to the other screen">
          <StackPanel Orientation="Horizontal"><TextBlock Text="🖥"/><TextBlock x:Name="ScreenText" Text="1" FontSize="12" VerticalAlignment="Center"/></StackPanel>
        </Button>
      </StackPanel>
      <Button x:Name="FoldBtn" Style="{StaticResource Tb}" Width="26" Content="‹" ToolTip="Make the toolbar small / big"/>
      <Button x:Name="CloseBtn" Style="{StaticResource Tb}" Width="28" Content="✕" FontSize="13" ToolTip="Quit Lecture Ink"/>
    </StackPanel>
    <!-- hover help is shown here, inside the toolbar, so OBS never records it (real tooltips are separate windows) -->
    <TextBlock x:Name="Hint" Visibility="Collapsed" Foreground="{StaticResource Ink}" FontSize="12" Margin="8,2,8,4" TextWrapping="Wrap" MaxWidth="640"/>
    </StackPanel>
  </Border>
</Window>
